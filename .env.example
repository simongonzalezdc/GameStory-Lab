# GameStory Lab Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# Database Configuration
# ============================================================================
DATABASE_URL=postgresql://gamestory:gamestory_dev_password@localhost:5432/gamestory

# ============================================================================
# AI Provider Configuration
# ============================================================================
# MiniMax is the primary provider (Anthropic-compatible API).
# Get your key from: https://platform.minimaxi.com/
MINIMAX_API_KEY=your-minimax-key-here
MINIMAX_API_BASE_URL=https://api.minimax.io/anthropic

# GLM (Zhipu AI, OpenAI-compatible API. Also used as cost-limit fallback.)
# Get your key from: https://open.bigmodel.cn/
GLM_API_KEY=your-glm-key-here
GLM_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# OpenRouter (Cloud AI - Optional)
# Provides access to DeepSeek V3, Qwen, GPT, Claude, Gemini
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Google Gemini (Cloud AI - Optional)
# Used for consistency validation with 1M context window
# Get your key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIzaSy-your-key-here

# Ollama (Local AI - Free & Unlimited, fallback provider)
# Recommended models:
#   - qwen3:30b-a3b (MoE: 30B quality, 3B memory - BEST!)
#   - phi4:14b (excellent reasoning)
#   - qwen3-coder:7b (best creative writing)
#   - qwen3:7b (best structured JSON)
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Pull models: ollama pull qwen3:30b-a3b && ollama pull phi4:14b
OLLAMA_BASE_URL=http://localhost:11434

# ============================================================================
# Application Configuration
# ============================================================================
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# Cost Protection (wired through to the AI orchestrator)
# ============================================================================
AI_COST_LIMIT_PER_HOUR_USD=5.00
