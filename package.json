{
  "name": "gamestory-lab",
  "version": "1.0.0",
  "description": "GameStory Lab - game narrative and story lab tooling for game writers and narrative designers",
  "private": true,
  "workspaces": [
    "packages/frontend",
    "packages/backend",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w packages/backend\" \"npm run dev -w packages/frontend\"",
    "build": "npm run build -w packages/shared && npm run build -w packages/backend && npm run build -w packages/frontend",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:migrate": "prisma migrate dev --schema packages/backend/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/backend/prisma/schema.prisma",
    "test:coverage": "npm run test --workspaces -- --coverage",
    "test:e2e": "npm --prefix e2e test",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "concurrently": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/simongonzalezdc/GameStory-Lab"
  },
  "keywords": [
    "game-design",
    "ai",
    "game-development",
    "concept-generator",
    "indie-games"
  ],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "adm-zip": "^0.6.1",
    "pg": "^8.23.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.23.0"
  }
}
