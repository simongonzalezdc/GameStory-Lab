{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json"],
      "groupName": "app-stack",
      "matchPackageNames": ["react", "react-dom", "vite", "typescript"]
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json"],
      "groupName": "ai-stack",
      "matchPackageNames": ["@ai-sdk/*", "ai", "ollama"]
    },
    {
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json"],
      "groupName": "test-tooling",
      "matchPackageNames": ["vitest", "@vitest/*", "playwright", "@playwright/*"]
    }
  ]
}
